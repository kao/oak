[user]
  name = Flavien Cogez
  email = flavien.cogez@gmail.com

[core]
  excludesfile = /Users/kao/.gitignore_global
  editor = vi
	ignorecase = false

[color]
  ui = true

[push]
  default = simple
	autoSetupRemote = true

[alias]
  st = status -sb
  df = diff --color
  # last tag
  lt = describe --abbrev=0

  ci = commit
  co = checkout
  cp = cherry-pick
  rbc = rebase --continue
  ph = push
  pl = pull

  stash-all = stash save --include-untracked

  br = for-each-ref --count=20 --sort=-committerdate refs/heads/ --format='%(HEAD) (%(color:green)%(committerdate:relative)%(color:reset)) %(color:yellow)%(refname:short)%(color:reset) [%(color:red)%(objectname:short)%(color:reset)] - %(contents:subject) by %(authorname)'
  lg = log --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit --date=relative

  # delete last commit
  undo = reset --soft HEAD~1

  pf = push --force-with-lease

[status]
  showUntrackedFiles = all

[pull]
	rebase = true

[rerere]
  enabled = true

[gc]
 auto = 0

[rebase]
  autosquash = true

[github]
  user = kao

[includeIf "gitdir:~/code/pennylane/"]
  path = ~/code/pennylane/.gitconfig
[blame]
	ignoreRevsFile = .git-blame-ignore-revs
[init]
	defaultBranch = main
